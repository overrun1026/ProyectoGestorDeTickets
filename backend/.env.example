

# Este archivo documenta las variables de entorno necesarias para ejecutar
# el backend y conectarlo a PostgreSQL de forma configurable.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://helpdesk:change_this_password@localhost:5432/helpdesk
JWT_SECRET=replace_this_with_a_random_secret_of_at_least_32_characters
JWT_EXPIRES_IN=1h
FRONTEND_URL=http://localhost:8080
DB_SSL=false
